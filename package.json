{
  "name": "react-utility-yard",
  "version": "2.1.0",
  "description": "A modern React component library with glassmorphic design system and theme management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./src/theme/tokens.css",
    "./styles.css": "./src/styles/components.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/theme/tokens.css",
    "src/styles/components.css",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist storybook-static",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/addon-themes": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.563.0",
    "material-icons": "^1.13.12",
    "postcss": "^8.4.40",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^6.0.0",
    "storybook": "^8.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infinity8sailor/react-utility-yard.git"
  },
  "keywords": [
    "react",
    "component-library",
    "glassmorphism",
    "design-system",
    "theme",
    "ui"
  ],
  "author": "Vaibhav Dasharathe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Infinity8sailor/react-utility-yard/issues"
  },
  "homepage": "https://github.com/Infinity8sailor/react-utility-yard#readme"
}